# Local-only demonstration: no cloud or database required
APP_MODE=demo
HOST=127.0.0.1
PORT=5000

# Optional local/GKE Gemma OpenAI-compatible endpoint (only used if configured)
# For the Session 2 codelab, port-forward the service and set this URL appropriately.
GEMMA_API_URL=
GEMMA_TIMEOUT_SECONDS=35

